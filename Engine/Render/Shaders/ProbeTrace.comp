#version 450

// One workgroup per probe. Trace each ray once and accumulate its contribution to six cosine lobes.
layout(local_size_x = 64) in;

struct Node {
    vec3 minimum;
    uint first;
    vec3 maximum;
    uint escape;
    uint count, pad0, pad1, pad2;
};
struct Triangle { vec4 origin, edge1, edge2, diffuse, emission; };
layout(std430, set = 0, binding = 0) readonly buffer Nodes { Node nodes[]; };
layout(std430, set = 0, binding = 1) readonly buffer Triangles { Triangle triangles[]; };
layout(std430, set = 0, binding = 2) readonly buffer Positions { vec4 positions[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Probes { vec4 probes[]; };
layout(push_constant) uniform TraceSettings {
    vec4 sunDirectionRange;
    vec4 sunRadiance;
    uint nodeCount, firstProbe, probeCount, reflections;
} settings;

const float rayBias = 0.002;
shared vec4 sampleDirectionDistance[64];
shared vec3 sampleRadiance[64];

bool intersects(Node node,vec3 origin,vec3 direction,float upper)
{
    float lower = rayBias;
    for (int axis = 0; axis < 3; ++axis) {
        if (abs(direction[axis]) < 1e-8) {
            if (origin[axis] < node.minimum[axis] || origin[axis] > node.maximum[axis])
                return false;
            continue;
        }
        float a = (node.minimum[axis]-origin[axis])/direction[axis];
        float b = (node.maximum[axis]-origin[axis])/direction[axis];
        lower = max(lower,min(a,b));
        upper = min(upper,max(a,b));
        if (lower > upper)
            return false;
    }
    return true;
}

float triangleDistance(Triangle triangle,vec3 origin,vec3 direction,float limit)
{
    // Share edge hits between adjacent triangles despite rounding in the barycentric test.
    const float edgeTolerance = 1e-6;
    vec3 edge1 = triangle.edge1.xyz, edge2 = triangle.edge2.xyz;
    vec3 perpendicular = cross(direction,edge2);
    float determinant = dot(edge1,perpendicular);
    if (abs(determinant) < 1e-8)
        return limit;
    vec3 offset = origin-triangle.origin.xyz;
    float u = dot(offset,perpendicular)/determinant;
    if (u < -edgeTolerance || u > 1.0+edgeTolerance)
        return limit;
    vec3 across = cross(offset,edge1);
    float v = dot(direction,across)/determinant;
    if (v < -edgeTolerance || u+v > 1.0+edgeTolerance)
        return limit;
    float distance = dot(edge2,across)/determinant;
    return distance > rayBias && distance < limit ? distance : limit;
}

bool traceRay(vec3 origin,vec3 direction,bool shadow,out uint hit,out float closest)
{
    closest = settings.sunDirectionRange.w;
    hit = 0xffffffffu;
    for (uint current = 0; current < settings.nodeCount;) {
        Node node = nodes[current];
        if (!intersects(node,origin,direction,closest)) {
            current = node.escape;
            continue;
        }
        for (uint i = node.first; i < node.first+node.count; ++i) {
            float distance = triangleDistance(triangles[i],origin,direction,closest);
            if (distance < closest) {
                closest = distance;
                hit = i;
                if (shadow)
                    return true;
            }
        }
        ++current;
    }
    return hit != 0xffffffffu;
}

vec3 incomingRadiance(vec3 position,vec3 direction,out float distance)
{
    uint hit;
    if (!traceRay(position,direction,false,hit,distance))
        return vec3(0.0); // the existing sky term supplies direct sky separately
    Triangle surface = triangles[hit];
    vec3 normal = normalize(cross(surface.edge1.xyz,surface.edge2.xyz));
    if (dot(normal,direction) > 0.0)
        normal = -normal;
    vec3 radiance = surface.emission.rgb;
    vec3 towardSun = settings.sunDirectionRange.xyz;
    float cosine = dot(normal,towardSun);
    if (cosine > 0.0 && any(greaterThan(settings.sunRadiance.rgb,vec3(0.0)))) {
        vec3 point = position+direction*distance+normal*(2.0*rayBias);
        uint occluder;
        float shadowDistance;
        if (!traceRay(point,towardSun,true,occluder,shadowDistance))
            radiance += surface.diffuse.rgb*settings.sunRadiance.rgb*cosine;
    }
    return radiance;
}

void main()
{
    uint lane = gl_LocalInvocationID.x;
    uint probe = settings.firstProbe+gl_WorkGroupID.x;
    float z = 1.0-2.0*(float(lane)+0.5)/64.0;
    float angle = float(lane)*2.39996323;
    vec3 direction = vec3(vec2(cos(angle),sin(angle))*sqrt(1.0-z*z),z);
    float distance;
    sampleRadiance[lane] = incomingRadiance(positions[probe].xyz,direction,distance);
    sampleDirectionDistance[lane] = vec4(direction,distance/settings.sunDirectionRange.w);
    barrier();

    // Store an octahedral image with a first-hit distance alongside each color.
    if (settings.reflections != 0u) {
        vec2 square = (vec2(lane%8u,lane/8u)+0.5)/4.0-1.0;
        vec3 ray = vec3(square,1.0-abs(square.x)-abs(square.y));
        float fold = max(-ray.z,0.0);
        ray.xy += mix(vec2(fold),vec2(-fold),greaterThanEqual(ray.xy,vec2(0.0)));
        vec3 radiance = incomingRadiance(positions[probe].xyz,normalize(ray),distance);
        probes[12u*settings.probeCount+64u*probe+lane] = vec4(radiance,distance/settings.sunDirectionRange.w);
    }
    if (lane >= 6)
        return;
    vec3 axis = vec3(0.0);
    axis[lane/2] = lane%2 == 0 ? 1.0 : -1.0;
    vec3 irradiance = vec3(0.0);
    vec2 moments = vec2(0.0);
    float total = 0.0;
    for (int i = 0; i < 64; ++i) {
        vec4 ray = sampleDirectionDistance[i];
        float weight = max(dot(axis,ray.xyz),0.0);
        total += weight;
        irradiance += sampleRadiance[i]*weight;
        moments += vec2(ray.w,ray.w*ray.w)*weight;
    }
    probes[12*probe+2*lane] = vec4(irradiance/total,0.0);
    probes[12*probe+2*lane+1] = vec4(moments/total,0.0,0.0);
}
