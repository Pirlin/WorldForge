diff --git a/intern/ghost/intern/GHOST_WindowWin32.cc b/intern/ghost/intern/GHOST_WindowWin32.cc
index 85718b39..8edbffaa 100644
--- a/intern/ghost/intern/GHOST_WindowWin32.cc
+++ b/intern/ghost/intern/GHOST_WindowWin32.cc
@@ -1227,13 +1227,19 @@ void GHOST_WindowWin32::endIME()
 void GHOST_WindowWin32::registerWindowAppUserModelProperties()
 {
   IPropertyStore *pstore;
-  char blender_path[MAX_PATH];
-  wchar_t shell_command[MAX_PATH];
+  wchar_t studio_path[MAX_PATH];
+  wchar_t shell_command[MAX_PATH + 2];
 
-  /* Find the current executable, and see if it's blender.exe if not bail out. */
-  GetModuleFileName(0, blender_path, sizeof(blender_path));
-  char *blender_app = strstr(blender_path, "blender.exe");
-  if (!blender_app) {
+  const DWORD length = GetModuleFileNameW(nullptr, studio_path, MAX_PATH);
+  if (length == 0 || length >= MAX_PATH) {
+    return;
+  }
+  wchar_t *filename = wcsrchr(studio_path, L'\\');
+  if (filename == nullptr ||
+      wcscpy_s(filename + 1,
+               MAX_PATH - (filename + 1 - studio_path),
+               L"WorldForgeStudioLauncher.exe") != 0)
+  {
     return;
   }
 
@@ -1242,10 +1248,8 @@ void GHOST_WindowWin32::registerWindowAppUserModelProperties()
     return;
   }
 
-  /* Set the launcher as the shell command so the console window will not flash.
-   * when people pin blender to the taskbar. */
-  strcpy(blender_app, "blender-launcher.exe");
-  wsprintfW(shell_command, L"\"%S\"", blender_path);
+  /* Pin the launcher so opening Studio from the taskbar does not flash a console. */
+  swprintf_s(shell_command, MAX_PATH + 2, L"\"%ls\"", studio_path);
   UTF16_ENCODE(BLENDER_WIN_APPID);
   UTF16_ENCODE(BLENDER_WIN_APPID_FRIENDLY_NAME);
   PROPVARIANT propvar;
