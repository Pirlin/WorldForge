+class WorldForgeAddSculptDetail(Operator):
+    """Add four sculpting subdivision levels while keeping the base mesh and its shape"""
+
+    bl_idname = "object.worldforge_add_sculpt_detail"
+    bl_label = "Add Sculpt Detail"
+    bl_options = {'UNDO'}
+
+    @classmethod
+    def poll(cls, context):
+        obj = context.sculpt_object
+        return bool(
+            obj and obj.type == 'MESH' and obj.is_editable and obj.data.is_editable
+            and not obj.modifiers and not obj.use_dynamic_topology_sculpting
+            and obj.data.users == 1 and obj.data.shape_keys is None
+            and 0 < len(obj.data.polygons) <= 128 and len(obj.data.vertices) <= 128
+        )
+
+    def execute(self, context):
+        obj = context.sculpt_object
+        try:
+            modifier = obj.modifiers.new("Sculpt Detail", 'MULTIRES')
+        except RuntimeError as error:
+            self.report({'ERROR'}, str(error))
+            return {'CANCELLED'}
+        try:
+            for level in range(1, 5):
+                result = bpy.ops.object.multires_subdivide(modifier=modifier.name, mode='SIMPLE')
+                if result != {'FINISHED'} or modifier.total_levels != level:
+                    raise RuntimeError("Could not subdivide this mesh for sculpting")
+        except RuntimeError as error:
+            bpy.ops.object.modifier_remove(modifier=modifier.name)
+            self.report({'ERROR'}, str(error))
+            return {'CANCELLED'}
+        modifier.levels = modifier.sculpt_levels = modifier.render_levels = modifier.total_levels
+        return {'FINISHED'}
+
