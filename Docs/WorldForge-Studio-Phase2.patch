+/* An older Studio document may still point at the built-in library in a different install. */
+static void resolve_studio_builtin_library(Main *bmain, Library *library)
+{
+  const char *absolute = library->runtime->filepath_abs;
+  std::string path(absolute);
+  std::replace(path.begin(), path.end(), '\\', '/');
+  const size_t folder = path.rfind("/datafiles/assets/");
+  if (folder == std::string::npos) {
+    return;
+  }
+  std::string relative = path.substr(folder + sizeof("/datafiles/assets/") - 1);
+  const size_t slash = relative.find('/');
+  if (slash == std::string::npos || relative.find('/', slash + 1) != std::string::npos ||
+      (relative.substr(0, slash) != "brushes" && relative.substr(0, slash) != "nodes"))
+  {
+    return;
+  }
+  if (relative.ends_with(".wflib")) {
+    relative.replace(relative.size() - 6, 6, ".blend");
+  }
+  if (relative.ends_with(".blend")) {
+    if (const auto assets = BKE_appdir_folder_id(BLENDER_SYSTEM_DATAFILES, "assets")) {
+      const std::string replacement = *assets + "/" + relative;
+      if (BLI_path_cmp(absolute, replacement.c_str()) != 0 && BLI_is_file(replacement.c_str())) {
+        BKE_library_filepath_set(bmain, library, replacement.c_str());
+      }
+    }
+  }
+}
