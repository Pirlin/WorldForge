+++ b/scripts/startup/bl_operators/worldforge_asset.py
@@ -0,0 +1,178 @@
+# SPDX-FileCopyrightText: 2026 WorldForge Studio contributors
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+"""Read and write WorldForge Studio authoring packages."""
+
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import tempfile
+import uuid
+import zipfile
+import zlib
+
+
+MANIFEST = "manifest.json"
+PAYLOAD = "source.blend"
+VERSION = 1
+MAX_MANIFEST = 64 * 1024
+MAX_SOURCE = 1024 ** 3
+CHUNK_SIZE = 1024 ** 2
+
+
+class PackageError(ValueError):
+    pass
+
+
+def _validate(manifest):
+    if not isinstance(manifest, dict) or type(manifest.get("format_version")) is not int:
+        raise PackageError("Invalid WorldForge asset manifest.")
+    if manifest["format_version"] != VERSION:
+        raise PackageError("This WorldForge asset uses an unsupported format version.")
+    try:
+        identity = manifest["asset_id"]
+        if str(uuid.UUID(identity)) != identity:
+            raise ValueError
+        revision = manifest["revision"]
+        writer = manifest["writer_version"]
+        digest = manifest["sha256"]
+        length = manifest["source_size"]
+        if (type(revision) is not int or revision < 1 or not isinstance(writer, str)
+                or not writer or len(writer) > 128 or manifest["asset_type"] != "scene"
+                or manifest["source"] != PAYLOAD or not isinstance(digest, str)
+                or len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest)
+                or type(length) is not int or not 0 < length <= MAX_SOURCE):
+            raise ValueError
+    except (AttributeError, KeyError, TypeError, ValueError) as error:
+        raise PackageError("Invalid asset identity, revision, or source metadata.") from error
+    return manifest
+
+
+def _stream(source, destination=None, max_size=MAX_SOURCE):
+    checksum = hashlib.sha256()
+    length = 0
+    while chunk := source.read(CHUNK_SIZE):
+        length += len(chunk)
+        if length > max_size:
+            raise PackageError("Asset source exceeds the declared size.")
+        checksum.update(chunk)
+        if destination is not None:
+            destination.write(chunk)
+    return length, checksum.hexdigest()
+
+
+def _read_manifest(archive):
+    entries = archive.infolist()
+    if len(entries) != 2 or {entry.filename for entry in entries} != {MANIFEST, PAYLOAD}:
+        raise PackageError("Unexpected, missing, or duplicate WorldForge asset entries.")
+    if archive.getinfo(MANIFEST).file_size > MAX_MANIFEST:
+        raise PackageError("WorldForge asset manifest is too large.")
+    manifest = _validate(json.loads(archive.read(MANIFEST)))
+    if archive.getinfo(PAYLOAD).file_size != manifest["source_size"]:
+        raise PackageError("Asset source size differs from the manifest.")
+    return manifest
+
+
+@contextmanager
+def _atomic_file(path):
+    fd, temp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w+b") as output:
+            yield output
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temp, path)
+    finally:
+        Path(temp).unlink(missing_ok=True)
+
+
+def read_package(path, extract_to=None):
+    """Validate the full payload before committing any extracted file."""
+    try:
+        with Path(path).open("rb") as container:
+            container.seek(0, os.SEEK_END)
+            size = container.tell()
+            if not 22 <= size <= MAX_SOURCE + 2 * 1024 ** 2:
+                raise PackageError("WorldForge asset exceeds the supported archive size.")
+            # The writer emits a single-disk ZIP with two entries and no archive comment.
+            container.seek(-22, os.SEEK_END)
+            marker, disk, start, on_disk, total, directory_size, offset, comment = struct.unpack(
+                "<4s4H2IH", container.read(22))
+            if (marker != b"PK\x05\x06" or disk or start or on_disk != 2 or total != 2
+                    or directory_size > 4096 or offset + directory_size != size - 22 or comment):
+                raise PackageError("Invalid WorldForge asset archive directory.")
+            with zipfile.ZipFile(container) as archive:
+                manifest = _read_manifest(archive)
+                with archive.open(PAYLOAD) as source:
+                    expected = manifest["source_size"], manifest["sha256"]
+                    if extract_to is None:
+                        if _stream(source, max_size=expected[0]) != expected:
+                            raise PackageError("Asset source checksum does not match.")
+                    else:
+                        with _atomic_file(Path(extract_to)) as output:
+                            if _stream(source, output, expected[0]) != expected:
+                                raise PackageError("Asset source checksum does not match.")
+                return manifest
+    except (zipfile.BadZipFile, json.JSONDecodeError, UnicodeError, RuntimeError,
+            NotImplementedError, EOFError, zlib.error) as error:
+        raise PackageError(f"Cannot read WorldForge asset: {error}") from error
+
+
+@contextmanager
+def _write_lock(path):
+    # Windows releases this lock automatically if the writer exits or crashes.
+    import msvcrt
+
+    lock_path = path.with_name(path.name + ".lock")
+    with lock_path.open("a+b") as lock:
+        lock.seek(0)
+        try:
+            msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)
+        except OSError as error:
+            raise PackageError("Another Studio session is saving this asset.") from error
+        try:
+            yield
+        finally:
+            lock.seek(0)
+            msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
+
+
+def write_package(path, source, writer_version, *, expected=None, identity=None):
+    """Commit a new or revised package without overwriting concurrent edits."""
+    path = Path(path)
+    if path.suffix.lower() != ".wfasset":
+        raise PackageError("WorldForge assets use the .wfasset extension.")
+    with _write_lock(path):
+        if path.exists():
+            if expected is None or read_package(path) != expected:
+                raise PackageError("This asset changed or already exists. Choose a new destination or reopen it.")
+        elif expected is not None:
+            raise PackageError("The original asset is missing. Use Save As to choose a destination.")
+
+        with _atomic_file(path) as output:
+            with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED, compresslevel=1) as archive:
+                with Path(source).open("rb") as payload, archive.open(PAYLOAD, "w", force_zip64=True) as member:
+                    length, digest = _stream(payload, member)
+                manifest = _validate({
+                    "format_version": VERSION,
+                    "asset_id": (expected or identity or {}).get("asset_id") or str(uuid.uuid4()),
+                    "revision": (expected or identity or {}).get("revision", 0) + 1,
+                    "asset_type": "scene",
+                    "writer_version": writer_version,
+                    "source": PAYLOAD,
+                    "source_size": length,
+                    "sha256": digest,
+                })
+                archive.writestr(MANIFEST, json.dumps(manifest, sort_keys=True).encode("utf-8"))
+            output.seek(0)
+            with zipfile.ZipFile(output) as archive:
+                if _read_manifest(archive) != manifest:
+                    raise PackageError("Could not validate the written package.")
+                with archive.open(PAYLOAD) as member:
+                    if _stream(member, max_size=length) != (length, digest):
+                        raise PackageError("Could not verify the written asset source.")
+    return manifest
diff --git a/scripts/startup/bl_operators/worldforge_documents.py b/scripts/startup/bl_operators/worldforge_documents.py
new file mode 100644
index 00000000..ebc142bc
--- /dev/null
+++ b/scripts/startup/bl_operators/worldforge_documents.py
@@ -0,0 +1,304 @@
+# SPDX-FileCopyrightText: 2026 WorldForge Studio contributors
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+"""WorldForge Studio document commands."""
+
+import json
+import os
+from pathlib import Path
+import tempfile
+
+import bpy
+from bpy.app.handlers import persistent
+from bpy.props import BoolProperty, EnumProperty, StringProperty
+from bpy.types import Menu, Operator
+from bpy_extras.io_utils import ImportHelper
+
+from .worldforge_asset import PackageError, _atomic_file, read_package, write_package
+
+
+_path = None
+_manifest = None
+_opening = False
+_scratch = None
+_autosave_minutes = 0
+
+
+def active_path():
+    return _path
+
+
+@persistent
+def reset_document(_):
+    global _path, _manifest, _scratch
+    if not _opening:
+        _path = _manifest = None
+        if _scratch is not None:
+            _scratch.cleanup()
+            _scratch = None
+
+
+def register_handlers():
+    if reset_document not in bpy.app.handlers.load_post:
+        bpy.app.handlers.load_post.append(reset_document)
+    if not bpy.app.background:
+        bpy.app.timers.register(_autosave, first_interval=60, persistent=True)
+
+
+def unregister_handlers():
+    if reset_document in bpy.app.handlers.load_post:
+        bpy.app.handlers.load_post.remove(reset_document)
+    if bpy.app.timers.is_registered(_autosave):
+        bpy.app.timers.unregister(_autosave)
+
+
+def _history_file():
+    return Path(bpy.utils.user_resource("CONFIG", create=True)) / "worldforge-recent.json"
+
+
+def recent_assets():
+    try:
+        value = json.loads(_history_file().read_text(encoding="utf-8"))
+        return [item for item in value[:12] if isinstance(item, str)] if isinstance(value, list) else []
+    except (OSError, ValueError):
+        return []
+
+
+def _remember(path):
+    entries = [str(path)] + [item for item in recent_assets() if item != str(path)]
+    try:
+        with _atomic_file(_history_file()) as output:
+            output.write(json.dumps(entries[:12]).encode("utf-8"))
+    except OSError:
+        # A read-only preferences directory must not invalidate an asset write.
+        pass
+
+
+def _recovery_file():
+    return _history_file().with_name("worldforge-autosave.wfasset")
+
+
+def _installed_library(path, libraries):
+    parts = path.parts
+    if len(parts) < 5 or parts[-4:-2] != ("datafiles", "assets"):
+        return None
+    version = parts[-5].split(".")
+    if len(version) != 2 or not all(number.isdecimal() for number in version):
+        return None
+    filename = path.with_suffix(".blend").name if path.suffix == ".wflib" else path.name
+    return libraries.get((parts[-2], filename))
+
+
+def _serialize(source):
+    essentials = (Path(bpy.utils.system_resource("DATAFILES")) / "assets").resolve()
+    libraries = {(folder, path.name): path.resolve() for folder in ("brushes", "nodes")
+                 for path in (essentials / folder).glob("*.blend")}
+    for library in bpy.data.libraries:
+        path = Path(bpy.path.abspath(library.filepath, library=library.parent))
+        installed = _installed_library(path, libraries)
+        if installed and path.resolve() != installed:
+            library.filepath = str(installed)
+    for image in bpy.data.images:
+        if image.library is None and image.is_dirty and image.source in {"FILE", "GENERATED", "TILED"}:
+            image.pack()
+            if not image.packed_files:
+                raise PackageError(f"Could not pack the painted image {image.name}.")
+    bpy.ops.file.pack_all()
+    external = []
+    for path in sorted(set(bpy.utils.blend_paths(absolute=True)) - {""}):
+        if _installed_library(Path(path).resolve(), libraries):
+            continue
+        external.append(path)
+    if external:
+        names = ", ".join(external[:3])
+        raise PackageError(f"Resolve or pack {len(external)} external dependencies first: {names}")
+    if bpy.ops.wm.save_as_mainfile(filepath=str(source), copy=True) != {"FINISHED"}:
+        raise PackageError("Studio could not serialize the editable scene.")
+
+
+def _autosave():
+    global _autosave_minutes
+    preferences = bpy.context.preferences.filepaths
+    if preferences.use_auto_save_temporary_files and bpy.data.is_dirty:
+        _autosave_minutes += 1
+        if _autosave_minutes >= preferences.auto_save_time:
+            _autosave_minutes = 0
+            try:
+                save_recovery()
+            except (OSError, RuntimeError, PackageError) as error:
+                print(f"WorldForge autosave skipped: {error}")
+    else:
+        _autosave_minutes = 0
+    return 60
+
+
+def save_recovery():
+    path = _recovery_file()
+    expected = read_package(path) if path.exists() else None
+    with tempfile.TemporaryDirectory(prefix="worldforge-autosave-") as directory:
+        source = Path(directory) / "source.blend"
+        _serialize(source)
+        write_package(path, source, bpy.app.version_string, expected=expected)
+
+
+def open_asset(path, *, remember=True, working_copy=False):
+    global _path, _manifest, _opening, _scratch
+    path = Path(path).resolve()
+    candidate = tempfile.TemporaryDirectory(prefix="worldforge-asset-")
+    try:
+        source = Path(candidate.name) / "source.blend"
+        manifest = read_package(path, source)
+        _opening = True
+        load_ui = os.environ.get("WORLDFORGE_EMBEDDED_STUDIO") != "1"
+        if bpy.ops.wm.open_mainfile(filepath=str(source), use_scripts=False, load_ui=load_ui) != {"FINISHED"}:
+            raise PackageError("Studio could not open the editable asset source.")
+    except Exception:
+        candidate.cleanup()
+        raise
+    finally:
+        _opening = False
+    if _scratch is not None:
+        _scratch.cleanup()
+    _scratch = candidate
+    _path, _manifest = (None if working_copy else path), manifest
+    if remember:
+        _remember(path)
+    return manifest
+
+
+def snapshot_asset(path, identity=None):
+    with tempfile.TemporaryDirectory(prefix="worldforge-publish-") as directory:
+        source = Path(directory) / "source.blend"
+        _serialize(source)
+        return write_package(path, source, bpy.app.version_string, identity=identity or _manifest)
+
+
+def save_asset(path, *, copy=False):
+    global _path, _manifest
+    path = Path(path).resolve()
+    if copy and path == _path:
+        raise PackageError("Save a Copy needs a different filename.")
+    with tempfile.TemporaryDirectory(prefix="worldforge-save-") as directory:
+        source = Path(directory) / "source.blend"
+        _serialize(source)
+        same_destination = path == _path and not copy
+        manifest = write_package(path, source, bpy.app.version_string,
+                                 expected=_manifest if same_destination else None,
+                                 identity=None if copy else _manifest)
+    if not copy:
+        _path, _manifest = path, manifest
+        _remember(path)
+    return manifest
+
+
+class WM_OT_worldforge_open_asset(Operator, ImportHelper):
+    bl_idname = "wm.worldforge_open_asset"
+    bl_label = "Open WorldForge Asset"
+    filename_ext = ".wfasset"
+    filter_glob: StringProperty(default="*.wfasset", options={"HIDDEN"})
+    skip_save_check: BoolProperty(default=False, options={"HIDDEN", "SKIP_SAVE"})
+
+    def invoke(self, context, event):
+        if self.filepath:
+            return self.execute(context)
+        return ImportHelper.invoke(self, context, event)
+
+    def execute(self, context):
+        if (not self.skip_save_check and not bpy.app.background
+                and (bpy.data.is_dirty or _path is not None)):
+            self.skip_save_check = True
+            return context.window_manager.invoke_confirm(
+                self, None, title="Open another asset?",
+                message="Save any unsaved work before opening a different asset.",
+                confirm_text="Open Asset", icon="WARNING")
+        try:
+            open_asset(self.filepath)
+        except (OSError, RuntimeError, PackageError) as error:
+            self.report({"ERROR"}, str(error))
+            return {"CANCELLED"}
+        return {"FINISHED"}
+
+
+class WM_OT_worldforge_save_asset(Operator):
+    bl_idname = "wm.worldforge_save_asset"
+    bl_label = "Save WorldForge Asset"
+
+    filepath: StringProperty(subtype="FILE_PATH")
+    filter_glob: StringProperty(default="*.wfasset", options={"HIDDEN"})
+    mode: EnumProperty(items=[
+        ("SAVE", "Save", "Save the active asset"),
+        ("SAVE_AS", "Save As", "Write the asset to a new path and retain its identity"),
+        ("COPY", "Save a Copy", "Write a separate asset with a new identity"),
+    ], default="SAVE", options={"SKIP_SAVE"})
+
+    def invoke(self, context, _event):
+        if self.mode == "SAVE" and _path:
+            self.filepath = str(_path)
+            return self.execute(context)
+        # Recovered documents and published working copies use a temporary
+        # extraction directory that is deleted when the document closes.
+        original = bpy.data.filepath if _scratch is None else ""
+        self.filepath = str(_path or Path(original or "Untitled").with_suffix(".wfasset"))
+        context.window_manager.fileselect_add(self)
+        return {"RUNNING_MODAL"}
+
+    def check(self, _context):
+        path = bpy.path.ensure_ext(self.filepath, ".wfasset", case_sensitive=False)
+        if path == self.filepath:
+            return False
+        self.filepath = path
+        return True
+
+    def execute(self, _context):
+        if not self.filepath and (self.mode != "SAVE" or _path is None):
+            self.report({"ERROR"}, "Choose a filename for the WorldForge asset.")
+            return {"CANCELLED"}
+        try:
+            path = bpy.path.ensure_ext(self.filepath or str(_path), ".wfasset", case_sensitive=False)
+            manifest = save_asset(path, copy=self.mode == "COPY")
+        except (OSError, RuntimeError, PackageError) as error:
+            self.report({"ERROR"}, str(error))
+            return {"CANCELLED"}
+        self.report({"INFO"}, f"Saved {Path(path).name} revision {manifest['revision']}")
+        return {"FINISHED"}
+
+
+class TOPBAR_MT_worldforge_recent(Menu):
+    bl_idname = "TOPBAR_MT_worldforge_recent"
+    bl_label = "Recent Assets"
+
+    def draw(self, _context):
+        self.layout.operator_context = "INVOKE_DEFAULT"
+        assets = recent_assets()
+        for path in assets:
+            self.layout.operator("wm.worldforge_open_asset", text=Path(path).name).filepath = path
+        if not assets:
+            self.layout.label(text="No recent WorldForge assets")
+
+
+class WM_OT_worldforge_recover_asset(Operator):
+    bl_idname = "wm.worldforge_recover_asset"
+    bl_label = "Recover WorldForge Autosave"
+
+    @classmethod
+    def poll(cls, _context):
+        return _recovery_file().is_file()
+
+    def invoke(self, context, event):
+        return context.window_manager.invoke_confirm(self, event)
+
+    def execute(self, _context):
+        try:
+            open_asset(_recovery_file(), remember=False)
+        except (OSError, RuntimeError, PackageError) as error:
+            self.report({"ERROR"}, str(error))
+            return {"CANCELLED"}
+        # Recovered work must be saved to a user-chosen path.
+        global _path, _manifest
+        _path = _manifest = None
+        return {"FINISHED"}
+
+
+classes = (WM_OT_worldforge_open_asset, WM_OT_worldforge_save_asset,
+           WM_OT_worldforge_recover_asset, TOPBAR_MT_worldforge_recent)
